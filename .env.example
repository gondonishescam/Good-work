PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your own Plivo DID, shown to the customer (no spoofing)
CALLER_ID=+15551234567
# Public base URL of this app (Plivo webhooks)
PUBLIC_URL=https://dialer.example.com
# 3CX: SIP URI of the sales queue/ring group reached via Plivo SIP trunk
THREECX_SIP_URI=sip:800@yourcompany.3cx.us
# Callback number announced in the message and voicemail (TCPA opt-out)
OPT_OUT_PHONE=+15551234567
COMPANY_NAME=Your Company
DB_PATH=press1.db

# Max simultaneous calls in flight (Plivo channels). Keep <= 3CX trunk simultaneous calls.
MAX_CONCURRENT_CALLS=20
# Plivo account CPS limit (calls created per second). Ask Plivo support to raise it.
CALLS_PER_SECOND=2
# Simultaneous calls the 3CX trunk/licence/agents can take. Press 1 above this -> callback message.
MAX_AGENT_CHANNELS=10
STALE_CALL_MINUTES=20
