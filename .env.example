PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your own Plivo DID, shown to the customer (no spoofing)
CALLER_ID=+15551234567
# Public base URL of this app (Plivo webhooks)
PUBLIC_URL=https://dialer.example.com
# 3CX: SIP URI of the sales queue/ring group reached via Plivo SIP trunk
THREECX_SIP_URI=sip:800@yourcompany.3cx.us
# Callback number announced in the message and voicemail (TCPA opt-out)
OPT_OUT_PHONE=+15551234567
COMPANY_NAME=Your Company
DB_PATH=press1.db
MAX_CALLS_PER_MINUTE=30
